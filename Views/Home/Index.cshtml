@{
    ViewData["Title"] = "الرئيسية";
}

<!-- Hero Section -->
<div class="text-center py-5 mb-4" style="background: linear-gradient(135deg, #2C3E50 0%, #3498DB 100%); border-radius: 20px; color: white;">
    <div class="py-4">
        <i class="fas fa-graduation-cap" style="font-size: 80px; margin-bottom: 20px;"></i>
        <h1 style="font-weight: 900; font-size: 3rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">منصة مدار التعليمية</h1>
        <p style="font-size: 1.3rem; opacity: 0.9; margin: 20px 0;">نظام متكامل لإدارة التعلم عن بعد</p>
        <a asp-controller="Lectures" asp-action="Index" class="btn btn-light btn-lg mt-2" style="font-weight: 700; color: #2C3E50; border-radius: 50px; padding: 12px 40px;">
            <i class="fas fa-book-open"></i> تصفح المحاضرات
        </a>
    </div>
</div>

<!-- بطاقات المميزات -->
<div class="row text-center mb-5">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body py-4">
                <i class="fas fa-video" style="font-size: 50px; color: #3498DB; margin-bottom: 15px;"></i>
                <h5 class="card-title">محاضرات مسجلة</h5>
                <p class="card-text text-muted">شاهد المحاضرات في أي وقت مع روابط فيديو يوتيوب مدمجة</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body py-4">
                <i class="fas fa-clipboard-check" style="font-size: 50px; color: #27AE60; margin-bottom: 15px;"></i>
                <h5 class="card-title">تسجيل حضور</h5>
                <p class="card-text text-muted">سجل حضورك بضغطة زر وتابع إحصائياتك</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body py-4">
                <i class="fas fa-chart-line" style="font-size: 50px; color: #F39C12; margin-bottom: 15px;"></i>
                <h5 class="card-title">لوحة إحصائيات</h5>
                <p class="card-text text-muted">للمدرسين: تابع حضور الطلاب وأداء المحاضرات</p>
            </div>
        </div>
    </div>
</div>